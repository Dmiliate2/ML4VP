package kokkos
#------------------------------ Setup Files ---------------------------------
variable			filename index ./Step3/S3_NPT_Example
variable			filename0 index ./Step2/S2_NPT_Example


#----------------------------- Box and atoms --------------------------------
units           	real
dimension       	3
boundary        	p p p
atom_style      	full


#------------------------ Defining the interactions -------------------------
pair_style      	lj/cut/coul/cut 12.0 12.0
bond_style      	harmonic
angle_style     	harmonic
dihedral_style 		opls
improper_style     	cvff
pair_modify 		mix geometric tail yes
special_bonds   	lj/coul 0.0 0.0 0.0
read_restart  		./${filename0}.restart
read_restart  		././Step2/S2_NPT_Example.restart

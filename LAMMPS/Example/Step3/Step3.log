neighbor        	2.0 bin
neigh_modify 		every 1 delay 0 check yes


#---------------------------Simulation Variables---------------------------
variable			nRun 		equal 50000					# Run for N timestep
variable			nRestart 	equal 10000 				# Write restart every N timesteps
variable 			nThermo 	equal 1000 					# Write every N timesteps
variable        	nfreq   	equal 1000	 				# Calculate averages every this many timesteps
variable        	nrepeat 	equal 100  					# Number of times to use input values for calculating averages
variable        	nevery  	equal 10    				# Use input values every this many timesteps
variable 			nDump 		equal 500					# Dump every N timesteps
variable 	 		highT 		equal 1000 					# [K] High Temp for randomization
variable        	eqmT 		equal 234 					# [K] Equilibration Temp
variable        	eqmP 		equal 1						# [atm] Equilibrium pressure
variable 			dt 			equal 1						# Timestep
variable 			tdamp 		equal 100*${dt}				# Temperature damping parameter
variable 			tdamp 		equal 100*1				
variable 			pdamp 		equal 1000*${dt}			# Pressure damping parameter
variable 			pdamp 		equal 1000*1			
timestep  			${dt}									# Apply timestep
timestep  			1									
reset_timestep  	0



#----------------------------- NPT Simulation -----------------------------
fix             	ensemble all npt temp ${eqmT} ${eqmT} ${tdamp} iso ${eqmP} ${eqmP} ${pdamp}
fix             	ensemble all npt temp 234 ${eqmT} ${tdamp} iso ${eqmP} ${eqmP} ${pdamp}
fix             	ensemble all npt temp 234 234 ${tdamp} iso ${eqmP} ${eqmP} ${pdamp}
fix             	ensemble all npt temp 234 234 100 iso ${eqmP} ${eqmP} ${pdamp}
fix             	ensemble all npt temp 234 234 100 iso 1 ${eqmP} ${pdamp}
fix             	ensemble all npt temp 234 234 100 iso 1 1 ${pdamp}
fix             	ensemble all npt temp 234 234 100 iso 1 1 1000
thermo 				${nThermo}
thermo 				1000
fix 				thermo_print all print ${nThermo} "$(step),$(temp),$(press),$(density),$(pxx),$(pyy),$(pzz),$(pxy),$(pxz),$(pyz),$(pe),$(ke),$(etotal),$(evdwl),$(ecoul),$(epair),$(ebond),$(eangle),$(edihed),$(eimp),$(emol),$(etail),$(enthalpy),$(vol)" 					append ${filename}_out.csv screen no title "step,temp,press,density,pxx,pyy,pzz,pxy,pxz,pyz,pe,ke,etotal,evdwl,ecoul,epair,ebond,eangle,edihed,eimp,emol,etail,enthalpy,vol"
fix 				thermo_print all print 1000 "$(step),$(temp),$(press),$(density),$(pxx),$(pyy),$(pzz),$(pxy),$(pxz),$(pyz),$(pe),$(ke),$(etotal),$(evdwl),$(ecoul),$(epair),$(ebond),$(eangle),$(edihed),$(eimp),$(emol),$(etail),$(enthalpy),$(vol)" 					append ${filename}_out.csv screen no title "step,temp,press,density,pxx,pyy,pzz,pxy,pxz,pyz,pe,ke,etotal,evdwl,ecoul,epair,ebond,eangle,edihed,eimp,emol,etail,enthalpy,vol"
fix 				thermo_print all print 1000 "$(step),$(temp),$(press),$(density),$(pxx),$(pyy),$(pzz),$(pxy),$(pxz),$(pyz),$(pe),$(ke),$(etotal),$(evdwl),$(ecoul),$(epair),$(ebond),$(eangle),$(edihed),$(eimp),$(emol),$(etail),$(enthalpy),$(vol)" 					append ./Step3/S3_NPT_Example_out.csv screen no title "step,temp,press,density,pxx,pyy,pzz,pxy,pxz,pyz,pe,ke,etotal,evdwl,ecoul,epair,ebond,eangle,edihed,eimp,emol,etail,enthalpy,vol"
dump            	dump1 all custom ${nDump} ${filename}_w.lammpstrj id mol type x y z mass q
dump            	dump1 all custom 500 ${filename}_w.lammpstrj id mol type x y z mass q
dump            	dump1 all custom 500 ./Step3/S3_NPT_Example_w.lammpstrj id mol type x y z mass q
dump            	dump2 all custom ${nDump} ${filename}_u.lammpstrj id mol type xu yu zu mass q
dump            	dump2 all custom 500 ${filename}_u.lammpstrj id mol type xu yu zu mass q
dump            	dump2 all custom 500 ./Step3/S3_NPT_Example_u.lammpstrj id mol type xu yu zu mass q
dump_modify     	dump1 sort id
dump_modify     	dump2 sort id
restart 			${nRestart} ${filename}_*restart.restart
restart 			10000 ${filename}_*restart.restart
restart 			10000 ./Step3/S3_NPT_Example_*restart.restart
run            		${nRun}
run            		50000

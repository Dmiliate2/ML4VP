package kokkos
#------------------------------ Setup Files ---------------------------------
variable			filename index ./Step2/S2_NPT_Example
variable			filename0 index ./Step1/S1_NVT_Example


#----------------------------- Box and atoms --------------------------------
units           	real
dimension       	3
boundary        	p p p
atom_style      	full


#------------------------ Defining the interactions -------------------------

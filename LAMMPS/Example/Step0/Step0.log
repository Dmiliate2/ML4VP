dump            	dump2 all custom 10 ./Step0/S0_Min_Example_u.lammpstrj id mol type xu yu zu mass q
dump_modify     	dump1 sort id
dump_modify     	dump2 sort id
# No progress restarts
minimize        	1.0e-16 1.06e-6 100000 500000

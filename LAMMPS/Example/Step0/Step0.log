#---------------------------Simulation Variables---------------------------
variable        	eqmT 		equal 234 			# [K] Equilibration Temp
variable        	eqmP 		equal 1				# [atm] Equilibrium pressure
variable 			nThermo 	equal 10 			# Write every N timesteps
variable 			nDump 		equal 10			# Dump every N timesteps (typically match thermo)
reset_timestep  	0













#---------------------------- Minimize Energy -----------------------------
velocity        	all create ${eqmT} 482648
velocity        	all create 234 482648
# No ensemble
thermo          	${nThermo}
thermo          	10
fix 				thermo_print all print ${nThermo} "$(step),$(temp),$(press),$(density),$(pxx),$(pyy),$(pzz),$(pxy),$(pxz),$(pyz),$(pe),$(ke),$(etotal),$(evdwl),$(ecoul),$(epair),$(ebond),$(eangle),$(edihed),$(eimp),$(emol),$(etail),$(enthalpy),$(vol)" 					append ${filename}_out.csv screen no title "step,temp,press,density,pxx,pyy,pzz,pxy,pxz,pyz,pe,ke,etotal,evdwl,ecoul,epair,ebond,eangle,edihed,eimp,emol,etail,enthalpy,vol"
fix 				thermo_print all print 10 "$(step),$(temp),$(press),$(density),$(pxx),$(pyy),$(pzz),$(pxy),$(pxz),$(pyz),$(pe),$(ke),$(etotal),$(evdwl),$(ecoul),$(epair),$(ebond),$(eangle),$(edihed),$(eimp),$(emol),$(etail),$(enthalpy),$(vol)" 					append ${filename}_out.csv screen no title "step,temp,press,density,pxx,pyy,pzz,pxy,pxz,pyz,pe,ke,etotal,evdwl,ecoul,epair,ebond,eangle,edihed,eimp,emol,etail,enthalpy,vol"
fix 				thermo_print all print 10 "$(step),$(temp),$(press),$(density),$(pxx),$(pyy),$(pzz),$(pxy),$(pxz),$(pyz),$(pe),$(ke),$(etotal),$(evdwl),$(ecoul),$(epair),$(ebond),$(eangle),$(edihed),$(eimp),$(emol),$(etail),$(enthalpy),$(vol)" 					append ./Step0/S0_Min_Example_out.csv screen no title "step,temp,press,density,pxx,pyy,pzz,pxy,pxz,pyz,pe,ke,etotal,evdwl,ecoul,epair,ebond,eangle,edihed,eimp,emol,etail,enthalpy,vol"
dump            	dump1 all custom ${nDump} ${filename}_w.lammpstrj id mol type x y z mass q
dump            	dump1 all custom 10 ${filename}_w.lammpstrj id mol type x y z mass q
dump            	dump1 all custom 10 ./Step0/S0_Min_Example_w.lammpstrj id mol type x y z mass q
dump            	dump2 all custom ${nDump} ${filename}_u.lammpstrj id mol type xu yu zu mass q

#------------------------------ Setup Files ---------------------------------
variable			filename index ./Step1/S1_NVT_Example
variable			filename0 index ./Step0/S0_Min_Example


#----------------------------- Box and atoms --------------------------------
units           	real
dimension       	3
boundary        	p p p
atom_style      	full


#------------------------ Defining the interactions -------------------------
pair_style      	lj/cut/coul/cut 12.0 12.0 
bond_style      	harmonic
angle_style     	harmonic
dihedral_style 		opls
improper_style     	cvff
pair_modify 		mix geometric tail yes
special_bonds   	lj/coul 0.0 0.0 0.0
read_restart  		./${filename0}.restart
neighbor        	2.0 bin
neigh_modify 		every 1 delay 0 check yes


#---------------------------Simulation Variables---------------------------
variable			nRun 		equal 50000					# Run for N timestep
variable			nRestart 	equal 10000 				# Write restart every N timesteps
variable 			nThermo 	equal 1000 					# Write every N timesteps
variable        	nfreq   	equal 1000	 				# Calculate averages every this many timesteps
variable        	nrepeat 	equal 100  					# Number of times to use input values for calculating averages
variable        	nevery  	equal 10    				# Use input values every this many timesteps
variable 			nDump 		equal 500					# Dump every N timesteps
variable 	 		highT 		equal 1000 					# [K] High Temp for randomization
variable        	eqmT 		equal 234 					# [K] Equilibration Temp 
variable        	eqmP 		equal 1						# [atm] Equilibrium pressure 
variable 			dt 			equal 1						# Timestep 
variable 			tdamp 		equal 100*${dt}				# Temperature damping parameter
variable 			pdamp 		equal 1000*${dt}			# Pressure damping parameter
timestep  			${dt}									# Apply timestep
reset_timestep  	0



#----------------------------- NVT Simulation -----------------------------
fix             	ensemble all nvt temp ${highT} ${highT} ${tdamp}
thermo 				${nThermo}
fix 				thermo_print all print ${nThermo} "$(step),$(temp),$(press),$(density),$(pxx),$(pyy),$(pzz),$(pxy),$(pxz),$(pyz),$(pe),$(ke),$(etotal),$(evdwl),$(ecoul),$(epair),$(ebond),$(eangle),$(edihed),$(eimp),$(emol),$(etail),$(enthalpy),$(vol)" & 
					append ${filename}_out.csv screen no title "step,temp,press,density,pxx,pyy,pzz,pxy,pxz,pyz,pe,ke,etotal,evdwl,ecoul,epair,ebond,eangle,edihed,eimp,emol,etail,enthalpy,vol"
dump            	dump1 all custom ${nDump} ${filename}_w.lammpstrj id mol type x y z mass q
dump            	dump2 all custom ${nDump} ${filename}_u.lammpstrj id mol type xu yu zu mass q
dump_modify     	dump1 sort id
dump_modify     	dump2 sort id
restart 			${nRestart} ${filename}_*restart.restart
run            		${nRun}
undump          	dump1
undump          	dump2
unfix				ensemble
write_restart   	${filename}.restart
write_data			${filename}.data